# ============================================================
# university-DS 生产环境变量配置模板
# 使用方法: 复制此文件为 .env 并填入真实值
# ============================================================

# 服务端口
SERVER_PORT=8080

# MySQL 数据库
MYSQL_URL=jdbc:mysql://localhost:3306/university_platform?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_strong_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# JWT 密钥 (生产环境务必更换为随机生成的安全密钥)
# 生成方式: openssl rand -base64 64
JWT_SECRET=your_random_base64_encoded_jwt_secret_at_least_256_bits

# 文件签名密钥 (独立于JWT密钥，用于文件下载/预览的签名URL)
# 生成方式: openssl rand -base64 32
FILE_SIGN_SECRET=your_random_base64_encoded_file_sign_secret_at_least_256_bits

# MinIO 对象存储
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=platform-files

# ============================================================
# Spring Profile (生产环境必须设置为 prod)
# ============================================================
SPRING_PROFILES_ACTIVE=prod
