/* pages/recruit/detail/detail.wxss */
.recruit-detail-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.detail-header {
  background: var(--color-header-bg);
  padding: 24rpx 32rpx 32rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-top: 16rpx;
  line-height: 1.4;
}

.header-meta {
  gap: 32rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.desc-content {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.match-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}
.match-item:last-child {
  border-bottom: none;
}

/* 底部栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-card);
  padding: 16rpx 32rpx;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* 申请管理 */
.application-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}
.application-item:last-child {
  border-bottom: none;
}

.empty-state-sm {
  padding: 32rpx 0;
  text-align: center;
}

.loading-wrap {
  padding: 32rpx 0;
  text-align: center;
}
