<!--pages/task/list/list.wxml-->
<view class="task-list-page">
  <view class="page-container">
    <!-- 筛选 -->
    <view class="filter-bar flex-row px-3">
      <view class="filter-item {{filterStatus === '' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="">
        全部
      </view>
      <view class="filter-item {{filterStatus === 'TODO' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="TODO">
        待开始
      </view>
      <view class="filter-item {{filterStatus === 'IN_PROGRESS' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="IN_PROGRESS">
        进行中
      </view>
      <view class="filter-item {{filterStatus === 'DONE' ? 'active' : ''}}" bindtap="onFilterStatus" data-status="DONE">
        已完成
      </view>
    </view>

    <block wx:if="{{!loading}}">
      <block wx:if="{{filteredTasks.length > 0}}">
        <view
          class="task-card card card-hover"
          wx:for="{{filteredTasks}}"
          wx:key="id"
          bindtap="goDetail"
          data-id="{{item.id}}"
        >
          <view class="flex-between mb-2">
            <view class="flex-row flex-1">
              <view class="priority-bar priority-{{item.priority || 'MEDIUM'}}"></view>
              <view class="task-title text-bold flex-1">{{item.title || item.name}}</view>
            </view>
            <t-tag size="small" variant="light" theme="{{statusTheme(item.status)}}">
              {{statusLabel(item.status)}}
            </t-tag>
          </view>
          <view class="text-sm text-secondary mb-2" wx:if="{{item.description}}">
            {{item.description}}
          </view>
          <view class="flex-between text-sm text-muted">
            <view class="flex-row">
              <t-icon name="user" size="24rpx" />
              <text class="ml-1">{{item.assigneeName || item.assignee || '未分配'}}</text>
            </view>
            <view class="flex-row">
              <t-icon name="time" size="24rpx" />
              <text class="ml-1">截止 {{item.deadline || item.dueDate || '未设置'}}</text>
            </view>
          </view>
        </view>
      </block>

      <view wx:else class="empty-state">
        <view class="empty-icon">📋</view>
        <view class="empty-text">暂无任务</view>
      </view>
    </block>

    <view wx:else class="loading-container">
      <t-loading theme="circular" size="60rpx" />
    </view>
  </view>
</view>
