/* pages/competition/list/list.wxss */
.competition-list-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.search-bar {
  background: var(--color-card);
  padding: 16rpx 24rpx;
}

.filter-bar {
  background: var(--color-card);
  padding: 12rpx 24rpx 16rpx;
  gap: 8rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.filter-item {
  padding: 8rpx 24rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg);
}

.filter-item.active {
  background: var(--color-primary);
  color: #fff;
}

.comp-card {
  margin-top: 16rpx;
}

.level-badge {
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.level-national { background: #f5222d; }
.level-provincial { background: var(--color-primary); }
.level-school { background: #52c41a; }
