/* pages/competition/detail/detail.wxss */
.comp-detail-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.detail-header {
  background: var(--color-header-bg);
  padding: 32rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.level-badge {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.level-national { background: #f5222d; }
.level-provincial { background: var(--color-primary); }
.level-school { background: #52c41a; }

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.info-value {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 500;
}

.desc-content {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  white-space: pre-wrap;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--color-card);
  padding: 16rpx 32rpx;
  box-shadow: 0 -1rpx 4rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}
