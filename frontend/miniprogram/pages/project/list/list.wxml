<!--pages/project/list/list.wxml-->
<view class="project-list-page">
  <view class="page-container">
    <block wx:if="{{!loading}}">
      <block wx:if="{{projects.length > 0}}">
        <view
          class="project-card card card-hover"
          wx:for="{{projects}}"
          wx:key="id"
          bindtap="goDetail"
          data-id="{{item.id}}"
        >
          <view class="flex-between mb-2">
            <view class="project-name text-bold text-lg flex-1">{{item.name}}</view>
            <t-tag size="small" variant="light" theme="primary">
              {{item.status || '进行中'}}
            </t-tag>
          </view>
          <view class="text-sm text-secondary mb-2" wx:if="{{item.description}}">
            {{item.description}}
          </view>
          <view class="flex-between">
            <view class="flex-row text-sm text-muted">
              <t-icon name="user" size="24rpx" />
              <text class="ml-1">{{item.memberCount || 0}}人</text>
            </view>
            <view class="flex-row text-sm text-muted">
              <t-icon name="task" size="24rpx" />
              <text class="ml-1">{{item.taskCount || 0}}个任务</text>
            </view>
            <text class="text-sm text-muted">{{item.createdAt || ''}}</text>
          </view>
        </view>
      </block>
      <view wx:else class="empty-state">
        <view class="empty-icon">📁</view>
        <view class="empty-text">暂无项目</view>
      </view>
    </block>
    <view wx:else class="loading-container">
      <t-loading theme="circular" size="60rpx" />
    </view>
  </view>
</view>
