/* pages/team/list/list.wxss */
.team-list-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.tab-bar {
  display: flex;
  background: var(--color-card);
  border-radius: var(--radius-md);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-muted);
  transition: all 0.2s;
}

.tab-item.active {
  color: var(--color-primary);
  border-bottom: 4rpx solid var(--color-primary);
  font-weight: 600;
}

/* Team Card */
.team-card {
  margin-top: 16rpx;
}

.team-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.team-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
  margin-top: 8rpx;
}

.team-footer {
  padding-top: 12rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.member-avatars {
  gap: 8rpx;
}

.member-avatar {
  margin-right: -8rpx;
}
