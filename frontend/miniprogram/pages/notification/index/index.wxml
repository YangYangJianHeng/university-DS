<!--pages/notification/index/index.wxml-->
<view class="notification-page">
  <view class="page-container">
    <!-- 全部已读 -->
    <view class="flex-between px-3 py-2 mb-3" wx:if="{{unreadCount > 0}}">
      <view class="flex-row">
        <t-icon name="check-circle" size="32rpx" color="#52c41a" />
        <text class="ml-2 text-sm text-muted">{{unreadCount}}条未读</text>
      </view>
      <t-button size="small" variant="text" theme="primary" bindtap="markAllRead">
        全部已读
      </t-button>
    </view>

    <!-- 通知列表 -->
    <block wx:if="{{!loading}}">
      <block wx:if="{{notifications.length > 0}}">
        <view
          class="notif-item card card-hover {{item.isRead ? 'read' : ''}}"
          wx:for="{{notifications}}"
          wx:key="id"
          bindtap="handleRead"
          data-id="{{item.id}}"
        >
          <view class="flex-row">
            <view class="notif-dot {{item.isRead ? 'read' : ''}}"></view>
            <view class="notif-content">
              <view class="notif-title">{{item.title || '通知'}}</view>
              <view class="notif-body">{{item.content || item.message || '暂无内容'}}</view>
              <view class="notif-time text-muted">{{formatTime(item.createdAt || item.time)}}</view>
            </view>
          </view>
          <view class="read-action" wx:if="{{!item.isRead}}">
            <t-icon name="check" size="24rpx" color="#4e6ef2" />
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view wx:else class="empty-state">
        <view class="empty-icon">📬</view>
        <view class="empty-text">暂无消息</view>
      </view>
    </block>

    <!-- 加载中 -->
    <view wx:else class="loading-container">
      <t-loading theme="circular" size="60rpx" />
    </view>

    <view class="safe-bottom"></view>
  </view>
</view>
