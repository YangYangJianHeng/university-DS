/* pages/notification/index/index.wxss */
.notify-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.header-action {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255,255,255,0.3);
  border-radius: 32rpx;
}
.header-action:active {
  background: rgba(255,255,255,0.15);
}

.notify-item {
  position: relative;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.notify-unread {
  background: var(--color-primary-lighter);
  border-left: 4rpx solid var(--color-primary);
}
.notify-read {
  opacity: 0.75;
}
.notify-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.icon-system { background: #EEF0FF; }
.icon-team { background: #ECFDF5; }
.icon-recruit { background: #FFFBEB; }
.icon-task { background: #EFF6FF; }
.icon-project { background: #FDF2F8; }
.icon-message { background: #F3F4F6; }

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--color-danger);
  flex-shrink: 0;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}
.loading-spinner {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
