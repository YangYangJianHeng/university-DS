/* pages/notification/index/index.wxss */
.notification-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.notif-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.notif-item.read {
  opacity: 0.6;
}

.notif-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f5222d;
  margin-top: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.notif-dot.read {
  background: #d9d9d9;
}

.notif-content {
  flex: 1;
  overflow: hidden;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notif-body {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.5;
}

.notif-time {
  font-size: 22rpx;
  margin-top: 8rpx;
}

.read-action {
  margin-left: 16rpx;
  margin-top: 8rpx;
  flex-shrink: 0;
}
