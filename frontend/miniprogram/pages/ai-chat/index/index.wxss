/* pages/ai-chat/index/index.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

.chat-scroll {
  flex: 1;
  padding: 24rpx;
}

/* 空状态 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.chat-avatar-lg {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.chat-title-lg {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}
.chat-desc {
  font-size: 26rpx;
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.suggestions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.suggest-item {
  background: var(--color-card);
  border: 1rpx solid var(--color-border-light);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
}
.suggest-item:active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  gap: 16rpx;
}
.msg-user {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}
.ai-avatar {
  background: var(--color-primary-light);
}
.user-avatar {
  background: var(--gradient-primary);
  color: #fff;
  font-weight: 700;
}

/* 气泡 */
.msg-bubble {
  max-width: 75%;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}
.msg-bubble-ai {
  background: var(--color-card);
  box-shadow: var(--shadow-sm);
  border-radius: 4rpx var(--radius-lg) var(--radius-lg) var(--radius-lg);
  color: var(--color-text-primary);
}
.msg-bubble-user {
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-lg) 4rpx var(--radius-lg) var(--radius-lg);
}
.msg-text {
  white-space: pre-wrap;
}

/* 加载动画 */
.msg-loading {
  padding: 28rpx 40rpx;
}
.typing-dots {
  display: flex;
  gap: 10rpx;
  align-items: center;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-muted);
  animation: typing 1.4s infinite;
}
.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-12rpx); opacity: 1; }
}

/* 输入栏 */
.chat-input-bar {
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-light);
  padding: 16rpx 24rpx;
}
.chat-input-bar .input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}
.input-placeholder {
  color: var(--color-text-placeholder);
}
.send-btn {
  width: 120rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}
.send-btn[disabled] {
  opacity: 0.4;
}
.send-btn:active {
  opacity: 0.85;
}

.chat-bottom-space {
  height: 40rpx;
}
