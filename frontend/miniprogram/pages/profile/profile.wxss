/* pages/profile/profile.wxss */
.profile-page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 头部 */
.profile-header {
  background: var(--color-header-bg);
  padding: 0 32rpx 24rpx;
}

.profile-info {
  display: flex;
  align-items: center;
  padding-top: 40rpx;
  padding-bottom: 24rpx;
}

.user-avatar {
  margin-right: 24rpx;
  flex-shrink: 0;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.user-role {
  margin-bottom: 4rpx;
}

.user-phone {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* 统计数据 */
.profile-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 20rpx 0;
  border: 1rpx solid var(--color-border-light);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: var(--color-border-light);
}

/* 快捷入口 */
.quick-actions {
  margin: 20rpx 24rpx 0;
  border-radius: var(--radius-md);
}

/* 菜单 */
.menu-section {
  margin: 0 24rpx;
}

.logout-section {
  padding: 0 40rpx;
}

/* 导师资料编辑弹窗 */
.teacher-dialog {
  width: 620rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
}
.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}
.dialog-body {
  padding: 0 32rpx 24rpx;
}
.form-item {
  margin-bottom: 28rpx;
}
.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.form-input {
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}
.form-picker {
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  display: flex;
  align-items: center;
}
.form-picker.placeholder { color: #c0c4cc; }
.form-textarea {
  min-height: 120rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  width: auto;
  box-sizing: border-box;
}
.dialog-footer {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx 32rpx;
}
