<!--pages/admin/task-manage/task-manage.wxml-->
<view class="page">
  <view class="header-bar">
    <view class="header-title">任务管理</view>
    <text class="header-total">共 {{total}} 个任务</text>
  </view>

  <view class="list">
    <view wx:if="{{loading}}" class="loading-wrap">
      <t-loading theme="circular" size="48rpx" text="加载中..." />
    </view>

    <block wx:elif="{{tasks.length > 0}}">
      <view class="item-card card" wx:for="{{tasks}}" wx:key="id">
        <view class="item-top">
          <view class="item-avatar">{{item.title ? item.title.charAt(0) : 'T'}}</view>
          <view class="item-info">
            <text class="item-name">{{item.title || '--'}}</text>
            <view class="item-meta">
              <text>项目ID: {{item.projectId || '--'}}</text>
              <text>负责人ID: {{item.assigneeId || '未分配'}}</text>
            </view>
          </view>
        </view>
        <view class="item-tags">
          <t-tag size="small" variant="light" theme="{{priorityTheme(item.priority)}}">
            {{priorityLabel(item.priority)}}
          </t-tag>
          <t-tag size="small" variant="light" theme="{{statusTheme(item.status)}}">
            {{statusLabel(item.status)}}
          </t-tag>
        </view>
        <view class="item-actions">
          <picker mode="selector" range="{{['HIGH','MEDIUM','LOW']}}" value="{{['HIGH','MEDIUM','LOW'].indexOf(item.priority)}}"
            bindchange="handleUpdatePriority" data-id="{{item.id}}">
            <t-button size="small" variant="text" theme="warning">改优先级</t-button>
          </picker>
          <picker mode="selector" range="{{['TODO','DOING','DONE']}}" value="{{['TODO','DOING','DONE'].indexOf(item.status)}}"
            bindchange="handleUpdateStatus" data-id="{{item.id}}">
            <t-button size="small" variant="text" theme="primary">改状态</t-button>
          </picker>
          <t-button size="small" variant="text" theme="danger" bindtap="handleDelete" data-id="{{item.id}}">
            删除
          </t-button>
        </view>
      </view>
    </block>

    <view wx:else class="empty-state">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无任务</view>
    </view>
  </view>
</view>
