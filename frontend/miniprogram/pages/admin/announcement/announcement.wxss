/* pages/admin/announcement/announcement.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 操作栏 */
.action-bar {
  padding: 24rpx;
  background: #fff;
  box-shadow: var(--shadow-sm);
}

/* 公告卡片 */
.announce-card {
  margin: 12rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.card-header {
  margin-bottom: 16rpx;
}

.text-bold {
  font-weight: 600;
  color: var(--color-text-primary);
}

.text-lg {
  font-size: 30rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-muted {
  color: var(--color-text-placeholder);
}

.mt-2 {
  margin-top: 12rpx;
}

.ml-2 {
  margin-left: 12rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
  align-items: center;
}

.announce-body {
  white-space: pre-wrap;
  word-break: break-all;
  line-height: 1.6;
}

/* 弹窗表单 */
.dialog-content {
  padding: 16rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 12rpx;
}

.type-selector {
  display: flex;
  gap: 16rpx;
}

.type-item {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg);
  transition: all 0.2s;
}

.type-item.active {
  background: var(--color-primary);
  color: #fff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-placeholder);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
