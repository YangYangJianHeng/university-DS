/* pages/admin/project-manage/project-manage.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--color-border-light);
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.header-total {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.list {
  padding: 12rpx 24rpx;
}

.item-card {
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.item-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.item-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #667eea, #764ba2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.item-meta {
  display: flex;
  gap: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
