<!--pages/admin/dashboard/dashboard.wxml-->
<view class="page-container">
  <view class="page-header">
    <view class="page-header-title">管理后台</view>
    <view class="page-header-sub">平台数据概览与管理</view>
  </view>

  <view class="page-inner">
    <!-- 核心统计 -->
    <view class="grid-2">
      <view class="stat-card" bindtap="goUsers">
        <view class="stat-number">{{stats.userCount}}</view>
        <view class="stat-label">👥 总用户</view>
      </view>
      <view class="stat-card" bindtap="goRecruits">
        <view class="stat-number">{{stats.recruitCount}}</view>
        <view class="stat-label">📋 活跃招募</view>
      </view>
      <view class="stat-card" bindtap="goProjects">
        <view class="stat-number">{{stats.projectCount}}</view>
        <view class="stat-label">📁 进行中项目</view>
      </view>
      <view class="stat-card" bindtap="goTeachers">
        <view class="stat-number">{{stats.teacherCount}}</view>
        <view class="stat-label">👨‍🏫 导师数</view>
      </view>
    </view>

    <!-- 本周数据 -->
    <view class="card mt-3">
      <view class="card-title">📊 本周新增</view>
      <view class="flex-between mt-2">
        <view class="text-sm text-secondary">新用户</view>
        <text class="text-bold text-brand">{{weekly.newUsers}}</text>
      </view>
      <view class="flex-between mt-2">
        <view class="text-sm text-secondary">新招募</view>
        <text class="text-bold text-brand">{{weekly.newRecruits}}</text>
      </view>
      <view class="flex-between mt-2">
        <view class="text-sm text-secondary">新项目</view>
        <text class="text-bold text-brand">{{weekly.newProjects}}</text>
      </view>
      <view class="flex-between mt-2">
        <view class="text-sm text-secondary">新团队</view>
        <text class="text-bold text-brand">{{weekly.newTeams}}</text>
      </view>
    </view>

    <!-- 管理入口 -->
    <view class="card mt-3">
      <view class="card-title">⚙️ 管理功能</view>
      <view class="grid-2 mt-2">
        <view class="admin-menu-item" bindtap="goUsers">👥 用户管理</view>
        <view class="admin-menu-item" bindtap="goRecruits">📋 招募审核</view>
        <view class="admin-menu-item" bindtap="goProjects">📁 项目管理</view>
        <view class="admin-menu-item" bindtap="goTeams">👥 团队管理</view>
        <view class="admin-menu-item" bindtap="goTasks">✅ 任务管理</view>
        <view class="admin-menu-item" bindtap="goTeachers">👨‍🏫 导师管理</view>
        <view class="admin-menu-item" bindtap="goAudit">📝 审核日志</view>
        <view class="admin-menu-item" bindtap="goAnnouncement">📢 公告管理</view>
      </view>
    </view>
  </view>
</view>
