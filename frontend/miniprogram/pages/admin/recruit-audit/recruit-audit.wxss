/* pages/admin/recruit-audit/recruit-audit.wxss */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 40rpx;
}

/* 统计栏 */
.summary-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: var(--shadow-sm);
}

.summary-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
}

.filter-tab {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
  background: var(--color-bg);
}

.filter-tab.active {
  background: var(--color-primary);
  color: #fff;
}

/* 审核卡片 */
.audit-card {
  margin: 12rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.text-bold {
  font-weight: 600;
  color: var(--color-text-primary);
}

.text-lg {
  font-size: 30rpx;
}

.text-sm {
  font-size: 24rpx;
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-muted {
  color: var(--color-text-muted);
}

.mb-2 {
  margin-bottom: 16rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
}

.meta-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.skill-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.result-info {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}
