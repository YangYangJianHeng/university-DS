<!--pages/admin/teacher-manage/teacher-manage.wxml-->
<view class="page">
  <view class="header-bar">
    <view class="header-title">导师管理</view>
    <text class="header-total">共 {{total}} 位导师</text>
  </view>

  <view class="list">
    <view wx:if="{{loading}}" class="loading-wrap">
      <t-loading theme="circular" size="48rpx" text="加载中..." />
    </view>

    <block wx:elif="{{teachers.length > 0}}">
      <view class="item-card card" wx:for="{{teachers}}" wx:key="id">
        <view class="item-top">
          <view class="item-avatar">👨‍🏫</view>
          <view class="item-info">
            <text class="item-name">{{item.department || '未填写院系'}}</text>
            <view class="item-meta">
              <text>{{item.title || '未填写职称'}}</text>
              <text>指导: {{item.currentTeams || 0}}/{{item.maxTeams || 0}}</text>
            </view>
            <view class="item-meta">
              <text class="text-muted">{{item.researchFields || '未填写研究方向'}}</text>
            </view>
          </view>
        </view>
        <view class="item-actions">
          <t-tag size="small" variant="light" theme="{{item.isVerified === 1 ? 'success' : 'default'}}">
            {{item.isVerified === 1 ? '已认证' : '未认证'}}
          </t-tag>
          <view class="action-btns">
            <t-button size="small" variant="text"
              theme="{{item.isVerified === 1 ? 'warning' : 'success'}}"
              bindtap="handleToggleVerified" data-id="{{item.id}}" data-verified="{{item.isVerified}}">
              {{item.isVerified === 1 ? '取消认证' : '认证'}}
            </t-button>
            <t-button size="small" variant="text" theme="danger" bindtap="handleDelete" data-id="{{item.id}}">
              删除
            </t-button>
          </view>
        </view>
      </view>
    </block>

    <view wx:else class="empty-state">
      <view class="empty-icon">🎓</view>
      <view class="empty-text">暂无导师</view>
    </view>
  </view>
</view>
