/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 40rpx;
}

.brand-section {
  width: 100%;
  background: var(--gradient-primary);
  padding: 80rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 48rpx 48rpx;
}
.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.2);
  margin-bottom: 20rpx;
}
.brand-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}
.brand-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
}

.login-card {
  width: 660rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 10;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 8rpx;
}
.card-subtitle {
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  margin-bottom: 36rpx;
}

.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
}
.input-wrapper {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border: 2rpx solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: 0 20rpx;
  transition: border-color var(--transition-fast);
}
.input-wrapper:focus-within {
  border-color: var(--color-primary);
}
.input-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}
.placeholder {
  color: var(--color-text-placeholder);
  font-size: 28rpx;
}
.eye-btn {
  font-size: 32rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

.captcha-row {
  display: flex;
  gap: 16rpx;
}
.captcha-input {
  flex: 1;
}
.captcha-img {
  width: 200rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.form-actions {
  margin-top: 40rpx;
  margin-bottom: 24rpx;
}

.switch-link {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}
.link-text {
  color: var(--color-primary);
  font-weight: 600;
}

.features-row {
  display: flex;
  gap: 48rpx;
  margin-top: 48rpx;
  padding: 0 40rpx;
}
.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.f-emoji {
  font-size: 40rpx;
}
.f-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
