/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: var(--color-header-bg);
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 品牌区 */
.brand-section {
  padding-top: 100rpx;
  text-align: center;
  margin-bottom: 48rpx;
}

.brand-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.brand-icon-text {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.brand-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 8rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* 登录卡片 */
.login-card {
  width: 100%;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-actions {
  margin-top: 48rpx;
}

.register-link {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* 特色列表 */
.features {
  width: 100%;
  display: flex;
  justify-content: space-around;
  margin-top: 48rpx;
  padding-bottom: 48rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
