<!--pages/login/login.wxml-->
<view class="login-page">
  <!-- 顶部品牌区 -->
  <view class="brand-section">
    <image class="brand-logo" src="/images/icon.png" mode="aspectFit" />
    <view class="brand-title">青创协同</view>
    <view class="brand-desc">大学生竞赛智能组队平台</view>
  </view>

  <!-- 登录表单 -->
  <view class="login-card card">
    <view class="card-title">账号登录</view>
    <view class="card-subtitle">欢迎回来，请登录你的账号</view>

    <view class="form-item">
      <view class="form-label">手机号</view>
      <view class="input-wrapper">
        <text class="input-emoji">📱</text>
        <input
          class="form-input"
          type="number"
          placeholder="请输入手机号"
          placeholder-class="placeholder"
          maxlength="11"
          value="{{form.phone}}"
          bindinput="onPhoneChange"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">密码</view>
      <view class="input-wrapper">
        <text class="input-emoji">🔒</text>
        <input
          class="form-input"
          type="{{showPassword ? 'text' : 'password'}}"
          placeholder="请输入密码"
          placeholder-class="placeholder"
          value="{{form.password}}"
          bindinput="onPasswordChange"
        />
        <text class="eye-btn" bindtap="togglePassword">{{showPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">验证码</view>
      <view class="captcha-row">
        <view class="input-wrapper captcha-input">
          <text class="input-emoji">🔐</text>
          <input
            class="form-input"
            type="text"
            placeholder="验证码"
            placeholder-class="placeholder"
            maxlength="6"
            value="{{form.captchaCode}}"
            bindinput="onCaptchaChange"
          />
        </view>
        <image class="captcha-img" src="{{captchaSrc}}" mode="aspectFill" bindtap="refreshCaptcha" />
      </view>
    </view>

    <view class="form-actions">
      <button class="btn btn-primary btn-block" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin">
        登录
      </button>
    </view>

    <view class="switch-link" bindtap="goRegister">
      <text>还没有账号？</text><text class="link-text">立即注册</text>
    </view>
  </view>

  <!-- 底部特色 -->
  <view class="features-row">
    <view class="feature-item">
      <text class="f-emoji">🎯</text>
      <text class="f-text">智能匹配</text>
    </view>
    <view class="feature-item">
      <text class="f-emoji">📋</text>
      <text class="f-text">全流程管理</text>
    </view>
    <view class="feature-item">
      <text class="f-emoji">🏆</text>
      <text class="f-text">竞赛中心</text>
    </view>
  </view>
</view>
