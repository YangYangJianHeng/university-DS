<!--pages/login/login.wxml-->
<view class="login-page">
  <!-- 顶部品牌区 -->
  <view class="brand-section">
    <view class="brand-icon">
      <text class="brand-icon-text">U</text>
    </view>
    <view class="brand-title">竞赛组队平台</view>
    <view class="brand-desc">大学生竞赛/科研项目组队匹配</view>
  </view>

  <!-- 登录表单 -->
  <view class="login-card card">
    <view class="section-header">账号登录</view>

    <view class="form-item">
      <t-input
        label="手机号"
        placeholder="请输入手机号"
        value="{{form.phone}}"
        bind:change="onPhoneChange"
        clearable
      />
    </view>

    <view class="form-item">
      <t-input
        label="密码"
        type="password"
        placeholder="请输入密码"
        value="{{form.password}}"
        bind:change="onPasswordChange"
      />
    </view>

    <view class="form-actions mt-4">
      <t-button
        theme="primary"
        size="large"
        block
        loading="{{loading}}"
        bind:tap="handleLogin"
        class="primary-btn"
      >
        登录
      </t-button>
    </view>

    <view class="register-link" bindtap="goRegister">
      还没有账号？<text class="text-primary">立即注册</text>
    </view>
  </view>

  <!-- 平台特色 -->
  <view class="features">
    <view class="feature-item">
      <view class="feature-icon">🎯</view>
      <text class="feature-text">智能匹配队友</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">📋</view>
      <text class="feature-text">项目全流程管理</text>
    </view>
    <view class="feature-item">
      <view class="feature-icon">🏆</view>
      <text class="feature-text">竞赛信息中心</text>
    </view>
  </view>
</view>
