<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.module.recruit.mapper.RecruitMapper">

    <resultMap id="BaseResultMap" type="com.platform.module.recruit.entity.Recruit">
        <id column="id" property="id"/>
        <result column="publisher_id" property="publisherId"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="project_type" property="projectType"/>
        <result column="required_skills" property="requiredSkills"/>
        <result column="max_members" property="maxMembers"/>
        <result column="current_members" property="currentMembers"/>
        <result column="deadline" property="deadline"/>
        <result column="status" property="status"/>
        <result column="view_count" property="viewCount"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="selectByFilters" resultMap="BaseResultMap">
        SELECT * FROM recruit
        <where>
            <if test="projectType != null and projectType != ''">
                AND project_type = #{projectType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

</mapper>
